# ===== 目标芯片 =====
CONFIG_IDF_TARGET="esp32s3"

# ===== Flash 16MB =====
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ===== 分区表：2x3.5MB app + 8MB storage =====
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/wordcard-16m.csv"

# ===== PSRAM（RLCD 帧缓冲和 LVGL 缓冲都在 PSRAM）=====
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ===== 系统 =====
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ===== storage 分区（FAT + 磨损均衡），放词库/发音/字库 =====
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ===== LVGL =====
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# ===== 日志 =====
# 这块板子没有板载 UART 桥，Type-C 走的是 S3 原生 USB，UART0 没人接。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ===== BLE：设备不联网，词表和发音只从 BLE 进 =====
# 只留 GATT 服务端 + BLE 角色，GATTC / SMP / BluFi / 扫描全砍，省内部 SRAM。
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=n
CONFIG_BT_BLE_BLUFI_ENABLE=n
CONFIG_BT_BLE_SMP_ENABLE=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_ADV_EN=y
CONFIG_BT_BLE_42_SCAN_EN=n
CONFIG_BT_BLE_42_DTM_TEST_EN=n
CONFIG_BT_BTU_TASK_STACK_SIZE=4352
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BT_MULTI_CONNECTION_ENBALE=n
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
# 注意别砍到 2：Bluedroid 起来时 GAP 和 GATT 两个内置服务就占掉两个 handle block，
# 留 2 个余量，否则 create_attr_tab 报 GATTS_ReserveHandles: no free handle blocks，
# 服务建不起来、广播也不会启动，而且只在建表回调里静默失败。
CONFIG_BT_GATT_MAX_SR_PROFILES=4
CONFIG_BT_GATT_MAX_SR_ATTRIBUTES=64
CONFIG_BT_CTRL_BLE_SCAN=n
